# LLM Provider (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0
# 会话快照的滑动过期时间（包含消息和待办理任务）
SESSION_TTL_SECONDS=1800
# 开发时可降级内存；正式部署建议false，Redis故障则明确返回错误
MEMORY_ALLOW_FALLBACK=true

# 百炼Embedding（与DeepSeek聊天模型独立配置）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# 离线评估的专用重排模型，复用百炼Key；不会自动替换线上LLM重排
RERANK_MODEL=qwen3-rerank
# RERANK_URL留空时由DASHSCOPE_BASE_URL的同地域host推导

# Milvus（长期知识库）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=smart_cs_kb_v4_1024_v1
MILVUS_TIMEOUT=30

# MySQL（订单、商品、工单、工单流转记录）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_cs
MYSQL_USER=smart_cs_app
MYSQL_PASSWORD=""

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000
