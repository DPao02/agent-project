# ============================================
# 多Agent智能会议助手系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# ---------- LLM API ----------
# 当前Python实现默认使用DeepSeek；配置本项目密钥，或复用共享uv工作区.env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# MiniMax API (推荐，支持中文)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_MODEL=abab6.5s-chat

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---------- 语音转写 ----------
# Whisper 配置
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=4
# 需要区分不同说话人时开启，并配置已获模型访问权限的HF_TOKEN。
DIARIZATION_ENABLED=false
HF_TOKEN=

# ---------- Jira 集成 ----------
JIRA_ENABLED=false
JIRA_SERVER=https://your-company.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=MEET

# ---------- 飞书集成 ----------
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_token

# ---------- 待办提醒 ----------
# 自动保存待办，无需确认；默认北京时间截止前3天/1天09:00各提醒一次。
# 未启用飞书Webhook时保存站内提醒；演示会议始终使用站内提醒。
REMINDERS_ENABLED=true
REMINDER_POLL_SECONDS=60
REMINDER_HOUR=9

# ---------- 数据库 ----------
# 会议项目使用独立数据库；应用账号需有此库的建表和读写权限。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=meeting_assistant
MYSQL_USER=meeting_assistant_app
MYSQL_PASSWORD=

# 完整结果在MySQL，Milvus仅保存会议语义索引。
MILVUS_ENABLED=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=meeting_assistant_v4_1024_v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
MAX_AUDIO_MB=256

# ---------- 服务配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WEBSOCKET_PORT=8001
LOG_LEVEL=INFO
